---
import { recentWork, disciplines } from '../../data/work.mjs';
import { caseStudies } from '../../data/case-studies.mjs';
import '../../styles/global.css';
import '../../styles/portfolio.css';
import '../../styles/editorial.css';

export function getStaticPaths() {
  return recentWork.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const caseStudy = caseStudies[project.id];
const heroCaption = caseStudy?.gallery?.find((asset) => asset.file === project.mediaFile)?.caption;
const extraGallery = (caseStudy?.gallery || []).filter((asset) => asset.file !== project.mediaFile);
const labels = project.categories
  .map((category) => disciplines.find((item) => item.id === category)?.label)
  .filter(Boolean)
  .join(' · ');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090c" />
    <meta name="description" content={project.description} />
    <meta property="og:title" content={`${project.title} | Rieg Rodig`} />
    <meta property="og:description" content={project.description} />
    <title>{project.title} | Rieg Rodig / riegulate</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>
    <div class="scanlines" aria-hidden="true"></div>
    <header class="site-header">
      <a class="wordmark" href={base}><span>R</span> riegulate</a>
      <nav aria-label="Navegação principal">
        <a href={`${base}#trabalhos`}>trabalhos</a>
        <a href={`${base}#portfolios`}>portfólios</a>
        <a href={`${base}#contact`}>contato</a>
      </nav>
      <a class="header-store" href="https://riegulate.lojavirtualnuvem.com.br/" target="_blank" rel="noopener noreferrer">Massa Demais ↗</a>
    </header>
    <main>
      <article class="shell project-detail-shell">
        <a class="project-back" href={`${base}#trabalhos`}>← Voltar aos trabalhos</a>
        <div class="project-detail-grid">
          {project.mediaFile ? (
            <figure class:list={['project-detail-figure', { 'project-detail-figure--interface': project.id === 'presenca-instavel' }]}>
              <img src={`${base}${project.mediaFile}`} alt={project.mediaAlt || project.title} width="1440" height="1000" fetchpriority="high" decoding="async" />
              {heroCaption && <figcaption>{heroCaption}</figcaption>}
            </figure>
          ) : (
            <div class="project-detail-poster" style={`--poster-accent:${project.accent};`} role="img" aria-label={`Cartaz tipográfico: ${project.title}`}>
              <span>{project.posterText}</span>
            </div>
          )}
          <div class="project-detail-info">
            <p class="section-code">{project.year} / {labels}</p>
            <h1>{project.title}</h1>
            <p>{project.description}</p>
            <dl class="project-facts">
              <div><dt>Atuação</dt><dd>{project.role}</dd></div>
              <div><dt>Situação</dt><dd>{project.status}</dd></div>
              <div><dt>Recursos</dt><dd>{project.tools}</dd></div>
            </dl>
            {!project.externalUrl && (
              <p class="project-material-note">Registros audiovisuais e documentação adicional podem ser solicitados para avaliação profissional.</p>
            )}
            <div class="contact-actions">
              {project.externalUrl && (
                <a class="button primary" href={project.externalUrl} target="_blank" rel="noopener noreferrer">{project.externalLabel || 'Ver projeto'} ↗</a>
              )}
              <a class:list={['button', { primary: !project.externalUrl, ghost: Boolean(project.externalUrl) }]} href="mailto:riegulate@gmail.com">Pedir materiais / entrar em contato ↗</a>
            </div>
          </div>
        </div>
        {caseStudy && (
          <section class="case-study" aria-labelledby="case-study-title">
            <div class="case-study-heading">
              <p class="section-code">ESTUDO DE CASO / {project.year}</p>
              <h2 id="case-study-title">{caseStudy.heading}</h2>
              <p>{caseStudy.intro}</p>
            </div>
            {(extraGallery.length > 0 || caseStudy.video) && (
              <div class="case-media" aria-label="Documentação visual e audiovisual">
                {extraGallery.map((media) => (
                  <figure class="case-media-photo">
                    <img src={`${base}${media.file}`} alt={media.alt} loading="lazy" decoding="async" />
                    <figcaption>{media.caption}</figcaption>
                  </figure>
                ))}
                {caseStudy.video && (
                  <figure class="case-media-video">
                    <div class="case-video-frame">
                      <iframe
                        src={caseStudy.video.embedUrl}
                        title={caseStudy.video.title}
                        loading="lazy"
                        allow="encrypted-media; picture-in-picture; fullscreen"
                        allowfullscreen
                        referrerpolicy="strict-origin-when-cross-origin"
                      ></iframe>
                    </div>
                    <figcaption>{caseStudy.video.caption}</figcaption>
                  </figure>
                )}
              </div>
            )}
            <div class="case-study-grid">
              <div class="case-study-panel">
                <h3>Contexto e desafio</h3>
                <p>{caseStudy.challenge}</p>
              </div>
              <div class="case-study-panel">
                <h3>Ficha técnica</h3>
                <dl class="project-facts">
                  <div><dt>Período</dt><dd>{caseStudy.date}</dd></div>
                  <div><dt>Local</dt><dd>{caseStudy.place}</dd></div>
                  <div><dt>Atuação</dt><dd>{caseStudy.involvement}</dd></div>
                </dl>
              </div>
              <div class="case-study-panel">
                <h3>Processo e execução</h3>
                <ul>
                  {caseStudy.execution.map((point) => <li>{point}</li>)}
                </ul>
              </div>
              <div class="case-study-panel">
                <h3>Entregas e situação</h3>
                <ul>
                  {caseStudy.outcomes.map((point) => <li>{point}</li>)}
                </ul>
              </div>
              {caseStudy.publicLinks.length > 0 && (
                <div class="case-study-panel case-study-panel--wide">
                  <h3>Ver mais</h3>
                  <p>Referências públicas vinculadas ao projeto:</p>
                  <div class="case-study-links">
                    {caseStudy.publicLinks.map((link) => (
                      <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </section>
        )}
      </article>
    </main>
    <footer class="shell">
      <span>© {new Date().getFullYear()} Rieg Rodig / riegulate</span>
      <span>Arte · Vídeo · Áudio · Desenvolvimento</span>
      <a href={`${base}#trabalhos`}>Voltar ao portfólio ↑</a>
    </footer>
  </body>
</html>
