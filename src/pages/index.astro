---
import ProjectCard from '../components/ProjectCard.astro';
import { projects as archiveProjects, portfolios } from '../data/projects.mjs';
import { disciplines, allWork, availableYears, recentWork } from '../data/work.mjs';
import { featuredIds } from '../data/case-studies.mjs';
import '../styles/global.css';
import '../styles/link-list.css';
import '../styles/portfolio.css';
import '../styles/editorial.css';

const base = import.meta.env.BASE_URL;
const storeUrl = 'https://riegulate.lojavirtualnuvem.com.br/';
const spriteUrl = `${base}assets/project-sprite.webp`;
const projects = allWork(archiveProjects);
const years = availableYears(projects);
const featuredProjects = featuredIds.map((id) => recentWork.find((project) => project.id === id)).filter(Boolean);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Portfólio de Rieg Rodig / riegulate: arte, vídeo, VJ, desenvolvimento criativo, aulas e áudio. Trabalhos de 2026, projetos e acervo." />
    <meta name="theme-color" content="#09090c" />
    <meta property="og:title" content="Rieg Rodig / riegulate — portfólio" />
    <meta property="og:description" content="Projetos e trabalhos em arte, audiovisual, jogos, desenvolvimento e música. Viva Usina, Metamuseu, Canal Zero e mais." />
    <meta property="og:type" content="website" />
    <title>riegulate — arte, som, vídeo e tecnologia criativa</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <style is:inline>
      @media (max-width: 700px) {
        .reveal { opacity: 1 !important; transform: none !important; }
      }
    </style>
  </head>
  <body style={`--sprite-url:url('${spriteUrl}')`}>
    <canvas id="world" aria-hidden="true"></canvas>
    <div class="noise" aria-hidden="true"></div>
    <div class="scanlines" aria-hidden="true"></div>

    <header class="site-header">
      <a class="wordmark" href="#top"><span>R</span> riegulate</a>
      <nav aria-label="Navegação principal">
        <a href="#trabalhos">trabalhos</a>
        <a href="#store">loja</a>
        <a href="#portfolios">portfólios</a>
        <a href="#redes">redes</a>
        <a href="#contact">contato</a>
      </nav>
      <a class="header-store" href="#contact">Vamos trabalhar ↗</a>
    </header>

    <main id="top">
      <section class="portfolio-hero shell" aria-labelledby="hero-title">
        <div class="portfolio-hero-main">
          <p class="signal"><span></span> RIEGULATE / JOÃO PESSOA, BR</p>
          <p class="portfolio-hero-tag">PORTFÓLIO · TRABALHOS SELECIONADOS / 2018—2026</p>
          <h1 id="hero-title"><span>Arte.</span><span>Som.</span><span>Código.</span></h1>
          <p class="portfolio-hero-lede">Sou Rieg Rodig. Faço música, videoarte, visuais ao vivo, edição, áudio, jogos e experiências interativas. Aqui estão trabalhos que podem ser vistos, ouvidos e explorados.</p>
          <div class="hero-actions">
            <a class="button primary" href="#trabalhos">Explorar trabalhos <b>↓</b></a>
            <a class="button ghost" href="#contact">Falar de um projeto ↗</a>
          </div>
          <div class="portfolio-hero-meta">
            <span>ARTE & VJ</span><span>VÍDEO</span><span>ÁUDIO</span><span>DEV CRIATIVO</span><span>AULAS</span>
          </div>
        </div>
        <div class="portfolio-hero-aside" aria-labelledby="featured-heading">
          <div class="portfolio-hero-aside-heading">
            <span class="section-code">EM FOCO / 2026</span>
            <h2 id="featured-heading">Três trabalhos recentes</h2>
          </div>
          <div class="featured-stack">
            {featuredProjects.map((project, index) => (
              <a href={`${base}trabalhos/${project.id}/`} class="featured-spotlight" style={`--spotlight-accent:${project.accent};`}>
                <span class="spotlight-number">0{index + 1}</span>
                <span class="spotlight-main">
                  <span class="spotlight-kicker">{project.eyebrow}</span>
                  <strong>{project.title}</strong>
                  <span class="spotlight-status">{project.status}</span>
                </span>
                <span class="spotlight-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
          <a class="portfolio-hero-more" href="#portfolios">Ver portfólios em PDF ↗</a>
        </div>
      </section>

      <section class="intro shell reveal" aria-labelledby="about-title">
        <div>
          <p class="section-code">00 / RIEGULATE</p>
          <h2 id="about-title">Música, imagem, jogos e tecnologia criativa.</h2>
        </div>
        <div class="bio-grid">
          <p><strong>SOBRE</strong> Rieg Rodig é músico, artista visual, VJ, editor, desenvolvedor criativo e professor de idiomas baseado em João Pessoa. Trabalha com som, imagem, programação e performance.</p>
          <p><strong>COMO USAR</strong> Filtre os trabalhos por área e ano, pesquise um projeto e abra os detalhes. O acervo inclui lançamentos, trabalhos profissionais e projetos em andamento.</p>
        </div>
      </section>

      <section id="trabalhos" class="work-section shell" aria-labelledby="links-title">
        <span id="links" class="anchor-alias" aria-hidden="true"></span>
        <div class="section-heading reveal">
          <div>
            <p class="section-code">01 / TRABALHOS E PROJETOS</p>
            <h2 id="links-title">O que fiz, faço e estou construindo.</h2>
          </div>
          <p>Trabalhos recentes, apresentações, videoarte, pós-produção, tecnologia criativa e lançamentos anteriores. Projetos em desenvolvimento estão identificados como tal.</p>
        </div>

        <div class="filter-dock" role="search" aria-label="Filtrar trabalhos">
          <div class="filter-inner">
            <span class="filter-label">EXPLORAR /</span>
            <div class="filters" role="group" aria-label="Filtrar por área">
              <button type="button" data-filter="all" aria-pressed="true" class="active">Tudo</button>
              {disciplines.map((discipline) => (
                <button type="button" data-filter={discipline.id} aria-pressed="false">{discipline.label}</button>
              ))}
            </div>
            <label class="year-filter">
              <span>Ano</span>
              <select id="year-filter" aria-label="Filtrar trabalhos por ano">
                <option value="all">Todos</option>
                {years.map((year) => <option value={year}>{year}</option>)}
                <option value="undated">Sem ano</option>
              </select>
            </label>
          </div>
          <div class="filter-secondary">
            <label class="search-filter">
              <span class="sr-only">Buscar pelo título, descrição ou tecnologia</span>
              <input id="project-search" type="search" placeholder="Buscar por projeto, técnica ou palavra-chave…" autocomplete="off" />
            </label>
            <span id="result-count" role="status" aria-live="polite">{projects.length} trabalhos</span>
            <button id="clear-filters" type="button">Limpar filtros</button>
          </div>
        </div>

        <div class="project-grid" id="project-grid">
          {projects.map((project) => (
            <div class="work-item" data-project>
              <ProjectCard project={project} />
            </div>
          ))}
        </div>
        <p id="empty-state" class="empty-state" hidden>Nenhum trabalho encontrado com esses filtros. Experimente outra área, ano ou busca.</p>
      </section>

      <section id="portfolios" class="portfolio-section shell" aria-labelledby="portfolio-title">
        <div class="section-heading reveal">
          <div>
            <p class="section-code">02 / PORTFÓLIOS</p>
            <h2 id="portfolio-title">Trabalhos por área.</h2>
          </div>
          <p>PDFs completos para curadores, produtores culturais, estúdios, emissoras e equipes de jogos.</p>
        </div>

        <div class="portfolio-grid">
          {portfolios.map((portfolio, index) => (
            <a class="portfolio-card reveal" href={portfolio.url} target="_blank" rel="noopener noreferrer" style={`--accent:${portfolio.accent}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div><strong>{portfolio.title}</strong><p>{portfolio.detail}</p></div>
              <b>↗</b>
            </a>
          ))}
        </div>
      </section>

      <section id="store" class="store-feature shell" aria-labelledby="store-title">
        <div class="store-feature-copy">
          <p class="section-code">PROJETO AUTORAL / LOJA</p>
          <h2 id="store-title">Massa Demais.</h2>
          <p>Camisetas e peças gráficas autorais, com humor nordestino, tipografia e visual retrô. Um projeto independente feito na Paraíba.</p>
          <a class="button primary" href={storeUrl} target="_blank" rel="noopener noreferrer">Conhecer a loja <b>↗</b></a>
        </div>
        <a class="store-feature-visual" href={storeUrl} target="_blank" rel="noopener noreferrer" aria-label="Visitar a loja Massa Demais">
          <img src={`${base}assets/featured-massa.webp`} alt="Arte promocional da Massa Demais" loading="lazy" width="1800" height="1080" />
          <span>PROJETO AUTORAL / MASSA DEMAIS ↗</span>
        </a>
      </section>

      <section id="redes" class="social-section shell reveal" aria-labelledby="social-title">
        <div class="section-heading">
          <div>
            <p class="section-code">03 / REDES E CANAIS</p>
            <h2 id="social-title">Acompanhe e escute.</h2>
          </div>
          <p>Redes sociais, música, vídeos e presença profissional.</p>
        </div>

        <div class="social-link-grid">
          <a href="https://www.instagram.com/riegulate/" target="_blank" rel="noopener noreferrer"><span>Instagram</span><b>↗</b></a>
          <a href="https://www.youtube.com/@riegulate6276" target="_blank" rel="noopener noreferrer"><span>YouTube</span><b>↗</b></a>
          <a href="https://open.spotify.com/artist/4Dfa9mVsHeAwyVZfLgiAt8" target="_blank" rel="noopener noreferrer"><span>Spotify · Riegulate</span><b>↗</b></a>
          <a href="https://soundcloud.com/riegulate" target="_blank" rel="noopener noreferrer"><span>SoundCloud</span><b>↗</b></a>
          <a href="https://www.behance.net/between2d" target="_blank" rel="noopener noreferrer"><span>Behance</span><b>↗</b></a>
          <a href="https://www.linkedin.com/in/riegulate/" target="_blank" rel="noopener noreferrer"><span>LinkedIn</span><b>↗</b></a>
          <a href="https://www.facebook.com/riegulate" target="_blank" rel="noopener noreferrer"><span>Facebook</span><b>↗</b></a>
          <a href="https://wa.me/5583988788180" target="_blank" rel="noopener noreferrer"><span>WhatsApp</span><b>↗</b></a>
        </div>
      </section>

      <section id="contact" class="contact shell reveal" aria-labelledby="contact-title">
        <div class="contact-portrait">
          <img src={`${base}assets/portrait.webp`} alt="Retrato de Rieg Rodig" width="800" height="800" loading="lazy" />
        </div>
        <div class="contact-copy">
          <p class="section-code">04 / CONTATO</p>
          <h2 id="contact-title">Vamos trabalhar juntos.</h2>
          <p>Disponível para apresentações, VJ e visuais ao vivo, edição de vídeo, motion graphics, pós-produção de áudio, sound design, desenvolvimento criativo e aulas de inglês e alemão.</p>
          <div class="contact-actions">
            <a class="button primary" href="https://wa.me/5583988788180" target="_blank" rel="noopener noreferrer">WhatsApp <b>↗</b></a>
            <a class="button ghost" href="mailto:riegulate@gmail.com">riegulate@gmail.com</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="shell">
      <span>© <span id="year"></span> Rieg Rodig / riegulate</span>
      <span>Astro · Three.js · p5.js</span>
      <a href="#top">voltar ao topo ↑</a>
    </footer>

    <script is:inline>
      window.setTimeout(() => {
        document.querySelectorAll('.reveal').forEach((node) => node.classList.add('visible'));
      }, 900);
    </script>
    <script is:inline type="module" src={`${base}site.js?v=20261103-2`} onerror="document.querySelectorAll('.reveal').forEach((node) => node.classList.add('visible'))"></script>
  </body>
</html>