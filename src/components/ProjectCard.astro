---
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const resolvedImage = project.mediaFile ? `${base}${project.mediaFile}` : project.image;
const hasImage = Boolean(project.sprite || resolvedImage);
const visualStyle = project.sprite
  ? `--image-size:500% 500%;--sprite-position:${project.sprite};`
  : resolvedImage
    ? `--image-url:url('${resolvedImage}');--image-size:cover;--sprite-position:center;`
    : `--poster-accent:${project.accent || '#d5ff3f'};`;
const href = project.url || `${base}trabalhos/${project.id}/`;
const action = project.action || 'Conhecer projeto';
const numericYear = /^\d{4}$/.test(project.year) ? project.year : '';
---
<a
  class:list={['project-card', 'reveal', { 'project-card--poster': !hasImage }]}
  href={href}
  target={project.url ? '_blank' : undefined}
  rel={project.url ? 'noopener noreferrer' : undefined}
  data-categories={(project.categories || []).join(' ')}
  data-year={numericYear}
  aria-label={`${action}: ${project.title}`}
>
  <span class:list={['project-image', { 'project-image--poster': !hasImage }]} style={visualStyle} role="img" aria-label={project.mediaAlt || project.title}>
    {!hasImage && (
      <span class="project-poster-type" aria-hidden="true">{project.posterText || project.title}</span>
    )}
    <span class="project-scan" aria-hidden="true"></span>
    <span class="project-year">{project.year}</span>
  </span>
  <span class="project-copy">
    <span class="project-eyebrow">{project.eyebrow}</span>
    <strong>{project.title}</strong>
    <span class="project-description">{project.description}</span>
    <span class="project-chips" aria-label="Áreas do projeto">
      {(project.categories || []).map((category) => (
        <span>{category === 'video' ? 'Vídeo' : category === 'audio' ? 'Áudio' : category === 'desenvolvimento' ? 'Dev' : category === 'aulas' ? 'Aulas' : 'Arte'}</span>
      ))}
    </span>
    <span class="project-footer"><span>{project.tools}</span><b>{action} ↗</b></span>
  </span>
</a>
